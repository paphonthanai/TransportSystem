rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Real security (replaces the earlier "allow read, write: if true" placeholder used while login was
    // a local-user system, not Firebase Auth). Every collection now requires request.auth != null and
    // checks the caller's role against /users/{uid}.role — matches src/services/permission.ts's
    // ROLE_PERMISSIONS map so app-level menu/route guards and Firestore-level enforcement agree.
    //
    // The /users/{uid}.role lookup itself needs read access to work — but Firestore rules can't grant
    // a user read on their own profile via a rule that reads that same profile without risking a
    // circular/expensive re-evaluation loop for other collections' checks, so isSignedIn() alone (no
    // role lookup) gates the /users read rule, and every other collection's role lookup reads that
    // already-open path.

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function hasRole(roles) {
      return isSignedIn() && isActive() && userRole() in roles;
    }

    // driverId ของบัญชีที่ล็อกอินอยู่ (มีความหมายเฉพาะ role DRIVER) ใช้จำกัดให้คนขับแก้ไข/อ่านได้แค่ข้อมูล "ของตัวเอง"
    // เท่านั้นใน self-service flow (เปลี่ยนอีเมล/PIN จาก Driver App) — ดู users/{uid}.driverId
    function myDriverId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.driverId;
    }

    function myDriverCode() {
      return get(/databases/$(database)/documents/drivers/$(myDriverId())).data.code;
    }

    // User profiles (role/name/active) — id เอกสาร = Firebase Auth uid เสมอ
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if hasRole(['ADMIN']);
      // Self-service: เจ้าของบัญชีซิงก์ field email ของตัวเองได้ (หลังเปลี่ยนอีเมลจริงผ่าน Firebase Auth สำเร็จแล้ว —
      // ดู authStore.updateOwnCredentials / DriverAppView.vue) แก้ได้เฉพาะ email เท่านั้น ห้ามแตะ role/active/driverId เอง
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if false; // ลบบัญชีจริงต้องผ่าน Firebase Auth (Admin SDK) — ที่นี่ปิดใช้งานผ่าน active:false แทน
    }

    match /customers/{customerId} {
      allow read, write: if hasRole(['ADMIN', 'STAFF', 'ACCOUNTING']);
    }

    // ผู้ติดต่อของลูกค้า (Contact) — Entity แยกจาก CustomerRecord.contact เดิม อ้างอิงกลับด้วย customerId สิทธิ์เดียวกับ customers
    match /contacts/{contactId} {
      allow read, write: if hasRole(['ADMIN', 'STAFF', 'ACCOUNTING']);
    }

    match /drivers/{driverId} {
      allow read, write: if hasRole(['ADMIN', 'DISPATCHER']);
      // Self-service: คนขับอ่าน/แก้ไข record ของ "ตัวเอง" เท่านั้นได้ (เปลี่ยนอีเมล/PIN จาก Driver App — ดู
      // stores/auth.ts updateOwnCredentials) แก้ได้เฉพาะ field authEmail เท่านั้น ห้ามแตะ field อื่นของตัวเอง
      // หรือ record ของคนขับคนอื่นเลย
      allow read: if isSignedIn() && hasRole(['DRIVER']) && myDriverId() == driverId;
      allow update: if isSignedIn() && hasRole(['DRIVER']) && myDriverId() == driverId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authEmail']);
    }

    // Index สาธารณะเล็กๆ "รหัสคนขับ -> authEmail ปัจจุบัน" ใช้ resolve ตอน Login ก่อน authenticate เท่านั้น (ไม่มี
    // ข้อมูลส่วนตัวอื่นในเอกสารนี้เลย) — allow get แบบ public เพราะต้องรู้ code เป๊ะถึงจะอ่านได้ (enumerate ไม่ได้
    // เพราะ list ปิดไว้) ดู repositories/driverAuthRepository.ts
    match /driverAuthEmails/{code} {
      allow get: if true;
      allow list: if hasRole(['ADMIN', 'DISPATCHER']);
      allow write: if hasRole(['ADMIN']) || (isSignedIn() && hasRole(['DRIVER']) && myDriverCode() == code);
    }

    // Driver App credentials (driverCode + driverLoginPassword) — เก็บแยกจาก /drivers/{id} โดยตั้งใจ เพราะ
    // DISPATCHER มีสิทธิ์ read/write /drivers/* ทั้ง collection อยู่แล้ว (ใช้จัดรถ) แต่ driverLoginPassword ต้องห้าม
    // DISPATCHER/STAFF เห็นเด็ดขาด — แยก collection ใหม่ที่ ADMIN เท่านั้นเขียนได้ บังคับสิทธิ์ตรงจุดโดยไม่กระทบ
    // สิทธิ์เดิมของ /drivers/* เลย
    //
    // allow get: if true (public) จำเป็นเพราะหน้า Login ต้องเทียบ driverLoginPassword ได้ "ก่อน" มี Firebase Auth
    // session จริง (สถาปัตยกรรม Frontend + Firestore ล้วน ไม่มี Cloud Functions ตามข้อกำหนด) ผลคือ driverLoginPassword
    // อ่านได้โดยใครก็ตามที่รู้/เดา driverCode ที่ถูกต้อง ไม่ใช่แค่ผ่านฟอร์ม Login เท่านั้น — เป็นข้อจำกัดของสถาปัตยกรรม
    // นี้เอง ไม่ใช่ช่องโหว่ที่แก้ตรงนี้ได้ถ้าไม่มี Backend ดู repositories/driverLoginCredentialsRepository.ts
    match /driverLoginCredentials/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if hasRole(['ADMIN']);
    }

    match /vehicles/{vehicleId} {
      allow read, write: if hasRole(['ADMIN', 'DISPATCHER']);
    }

    match /bookings/{bookingId} {
      allow read, create, update: if hasRole(['ADMIN', 'DISPATCHER', 'STAFF', 'ACCOUNTING']);
      // Hard Delete Booking — เฉพาะ ADMIN เท่านั้น (แยกจาก create/update ด้านบนโดยเจตนา DISPATCHER/STAFF/ACCOUNTING
      // ยังคงสร้าง/แก้ไข Booking ได้เหมือนเดิมทุกประการ แค่ลบถาวรไม่ได้) ดู stores/booking.ts's hardDeleteBooking
      // ที่บังคับสิทธิ์เดียวกันซ้ำอีกชั้นฝั่ง Application ก่อนเรียกมาถึงจุดนี้
      allow delete: if hasRole(['ADMIN']);
      // DRIVER: อ่าน/แก้ไขได้เฉพาะงานของตัวเอง (Driver App ใช้ booking document เป็น state ของการปฏิบัติงานจริง —
      // รับงาน/รับสินค้า/ส่งของ/จบงาน ดู stores/booking.ts acceptDispatch/pickupJobItem/deliverJobItem/finishDriverJob)
      // ห้ามสร้าง/ลบงานเด็ดขาด — งานทั้งหมดสร้าง/ลบจากฝั่งหลังบ้านเท่านั้น (ไม่มี allow create/delete ให้ DRIVER ตรงนี้
      // เจตนา) และห้ามแก้ driverId ให้หนีไปเป็นของคนขับคนอื่นผ่านการ update เอง
      allow read: if isSignedIn() && hasRole(['DRIVER']) && resource.data.driverId == myDriverId();
      allow update: if isSignedIn() && hasRole(['DRIVER']) && resource.data.driverId == myDriverId() &&
        request.resource.data.driverId == resource.data.driverId;
    }

    // สมุดรายชื่อเสมียน (StaffView.vue) — ตรงกับ meta.roles ของ route settings/staff
    match /staff/{staffId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    // สมุดรายชื่อผู้จำหน่าย (VendorsView.vue) — route settings/vendors ยังปิดใช้งานอยู่ (comment out ใน router/app.ts)
    // เตรียม Rules ไว้ล่วงหน้าเผื่อเปิดใช้งานทีหลัง ไม่ให้ลืมแล้วเผลอปล่อย if true
    match /vendors/{vendorId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    // ค่าตั้งค่าระบบแบบเอกสารเดียว (ค่าน้ำมัน/เงื่อนไขวางบิล/เลขรันเอกสาร ฯลฯ) — sync ข้ามเครื่องผ่าน useFirestoreSettings
    // อ่านได้ทุก role ที่ล็อกอินอยู่ (ใช้แสดงผลในหลายหน้า) แต่แก้ไขได้เฉพาะ ADMIN
    match /settings/{settingKey} {
      allow read: if hasRole(['ADMIN', 'STAFF', 'DISPATCHER', 'ACCOUNTING', 'DRIVER']);
      allow write: if hasRole(['ADMIN']);
    }

    // ทะเบียนเลขที่เอกสารถาวร (Phase 4 — ป้องกันเลขที่เอกสารย้อนกลับ/ซ้ำ) เขียนทุกครั้งที่ออกเอกสารขาย
    // จึงต้องเปิดให้ role เดียวกับที่สร้าง salesDocuments ได้ (ไม่ใช่ ADMIN อย่างเดียวเหมือน settings ทั่วไป)
    match /settings/documentNumberRegistry {
      allow read, write: if hasRole(['ADMIN', 'STAFF', 'ACCOUNTING', 'DISPATCHER']);
    }

    // ต้นทาง/จุดรับสินค้า
    match /origins/{originId} {
      allow read: if hasRole(['ADMIN', 'STAFF', 'DISPATCHER', 'ACCOUNTING', 'DRIVER']);
      allow write: if hasRole(['ADMIN']);
    }

    // สินค้า/สต๊อก — DISPATCHER และ DRIVER เขียนได้เพราะ Driver App ตัดสต๊อกอัตโนมัติตอนรับสินค้า (pickupJobItem)
    match /products/{productId} {
      allow read: if hasRole(['ADMIN', 'STAFF', 'DISPATCHER', 'ACCOUNTING', 'DRIVER']);
      allow write: if hasRole(['ADMIN', 'DISPATCHER', 'DRIVER']);
    }

    match /stockMovements/{movementId} {
      allow read: if hasRole(['ADMIN', 'DISPATCHER']);
      allow write: if hasRole(['ADMIN', 'DISPATCHER', 'STAFF', 'DRIVER']);
    }

    // เอกสารขาย (ใบเสนอราคา/ใบสั่งขาย/ใบวางบิล/ใบกำกับภาษี/ใบเสร็จ) — ตรงกับ meta.roles ของ route กลุ่มเอกสารขาย
    // salesDocuments รวมทุกประเภทเอกสาร (QUOTATION/SALES_ORDER/BILLING/TAX_INVOICE/RECEIPT/CASH_SALE/PURCHASE_ORDER)
    // ไว้ใน collection เดียว — STAFF/DISPATCHER ยังต้องเขียนได้จริงเฉพาะ QUOTATION (หน้าใบเสนอราคา) และ SALES_ORDER
    // (สร้าง/ลบพร้อม Booking ดู createSalesOrderForBooking/deleteSalesOrder ใน stores/salesDocuments.ts) เท่านั้น
    // — เอกสารฝั่งบัญชี (BILLING/TAX_INVOICE/RECEIPT/CASH_SALE/PURCHASE_ORDER) ทุกหน้าที่เขียนถึงล้วนเป็นเส้นทางที่มี
    // meta.roles จำกัดแค่ ADMIN/ACCOUNTING อยู่แล้วในระดับ route guard เป็นทุนเดิม (ตรวจสอบทุกเส้นทางแล้วก่อนแก้กฎนี้)
    // จึงจำกัดฝั่ง Firestore ให้ตรงกันเพื่อไม่ให้เขียนได้ผ่านการเรียก API ตรงๆ ข้าม route guard — ไม่เพิ่มสิทธิ์ใหม่ให้ STAFF/
    // DISPATCHER เลย (ตรงกับที่ทำได้อยู่แล้วในแอปทุกประการ)
    function isSalesDocRestrictedType(t) {
      return !(t in ['QUOTATION', 'SALES_ORDER']);
    }
    match /salesDocuments/{docId} {
      allow read: if hasRole(['ADMIN', 'STAFF', 'ACCOUNTING', 'DISPATCHER']);
      allow create, update: if hasRole(['ADMIN', 'ACCOUNTING']) ||
        (hasRole(['STAFF', 'DISPATCHER']) && !isSalesDocRestrictedType(request.resource.data.type));
      allow delete: if hasRole(['ADMIN', 'ACCOUNTING']) ||
        (hasRole(['STAFF', 'DISPATCHER']) && !isSalesDocRestrictedType(resource.data.type));
    }

    // salesDocumentItems ไม่มีฟิลด์ type ของตัวเอง (มีแค่ documentId อ้างถึงเอกสารแม่ใน salesDocuments) จึงต้อง get()
    // เอกสารแม่มาเช็ค type แทนสำหรับ create/update (เอกสารแม่ยังคงอยู่แน่นอนตอนนั้น ไม่มีปัญหา race) — allow delete คงเปิด
    // ให้ทุก role เดิมเหมือนก่อนแก้กฎนี้โดยเจตนา ไม่ผูกกับ type ของเอกสารแม่ เพราะ deleteSalesOrder (STAFF ใช้ได้จริง
    // ผ่าน SalesOrderListView.vue) ลบเอกสารแม่กับ item พร้อมกันในจังหวะเดียว (สอง watcher แยกกันใน salesDocuments.ts
    // ไม่รับประกันลำดับการยิง Firestore write) ผูก type-check กับ delete ตรงนี้เสี่ยง race แล้ว get() เอกสารแม่ไม่เจอ
    // (ถูกลบไปพร้อมกันแล้ว) ทำให้ลบ item ไม่สำเร็จ กลายเป็น item ค้าง — item เดี่ยวๆ ไม่มีมูลค่าเอกสารในตัวเอง (ตัว
    // เอกสารแม่ต่างหากที่คุม type-based create/update/delete เข้มแล้วด้านบน) จึงปล่อย delete item ตามเดิมได้อย่างปลอดภัย
    match /salesDocumentItems/{itemId} {
      allow read: if hasRole(['ADMIN', 'STAFF', 'ACCOUNTING', 'DISPATCHER']);
      allow create, update: if hasRole(['ADMIN', 'ACCOUNTING']) ||
        (hasRole(['STAFF', 'DISPATCHER']) &&
          !isSalesDocRestrictedType(get(/databases/$(database)/documents/salesDocuments/$(request.resource.data.documentId)).data.type));
      allow delete: if hasRole(['ADMIN', 'STAFF', 'ACCOUNTING', 'DISPATCHER']);
    }

    // หนังสือรับรองหัก ณ ที่จ่าย — route wht-certificates
    match /whtCertificates/{certId} {
      allow read, write: if hasRole(['ADMIN', 'ACCOUNTING']);
    }

    // รายการหักเงินเดือนคนขับต่อรอบ — หน้าเงินเดือน (payroll/*) ทุก route จำกัดแค่ ADMIN อยู่แล้ว
    match /payrollDeductions/{deductionId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    // เงินเดือนพนักงานเสมียน (payroll/staff) — เช่นเดียวกับ payrollDeductions จำกัดแค่ ADMIN อยู่แล้ว
    match /staffSalaries/{salaryId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    // ค่าใช้จ่ายประจำรถ (ประกัน/GPS/ค่างวด/อื่นๆ) ผูกกับ vehicleId — ข้อมูลการเงินของรถ จำกัดแค่ ADMIN เหมือน payrollDeductions/staffSalaries
    match /vehicleExpenses/{expenseId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    // สถานะจ่ายรายได้คนขับต่อรอบ (ยังไม่จ่าย/จ่ายแล้ว) — แยกจาก Operational Status ของ Booking โดยเจตนา จำกัดแค่ ADMIN เหมือน payrollDeductions
    match /driverPayments/{paymentId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
