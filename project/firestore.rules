rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Incremental localStorage -> Firestore migration (see stores/*.ts + repositories/*.ts).
    // Only collections that have actually been migrated get a rule below; everything else
    // still lives in browser localStorage and stays denied by the catch-all at the bottom.
    //
    // NOTE: login (Phase 0, src/stores/localUsers.ts + src/stores/auth.ts) is a local-user system
    // backed by localStorage, not Firebase Auth — it never calls signInWithEmailAndPassword, so
    // request.auth is always null even though the UI shows a signed-in user. Rules that required
    // request.auth != null would silently reject every read/write from this app today.
    // Opened without an auth check as an explicit, temporary trade-off for this phase; MUST be
    // tightened (e.g. request.auth != null, or role-based checks) once real Firebase Auth login
    // replaces the local-user system.

    // Phase 1: customers
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Phase 2: drivers
    match /drivers/{driverId} {
      allow read, write: if true;
    }

    // Phase 3: vehicles
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // Phase 4: bookings
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
