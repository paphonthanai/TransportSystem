rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Real security (replaces the earlier "allow read, write: if true" placeholder used while login was
    // a local-user system, not Firebase Auth). Every collection now requires request.auth != null and
    // checks the caller's role against /users/{uid}.role — matches src/services/permission.ts's
    // ROLE_PERMISSIONS map so app-level menu/route guards and Firestore-level enforcement agree.
    //
    // The /users/{uid}.role lookup itself needs read access to work — but Firestore rules can't grant
    // a user read on their own profile via a rule that reads that same profile without risking a
    // circular/expensive re-evaluation loop for other collections' checks, so isSignedIn() alone (no
    // role lookup) gates the /users read rule, and every other collection's role lookup reads that
    // already-open path.

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function hasRole(roles) {
      return isSignedIn() && isActive() && userRole() in roles;
    }

    // User profiles (role/name/active) — id เอกสาร = Firebase Auth uid เสมอ
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if hasRole(['ADMIN']);
      allow delete: if false; // ลบบัญชีจริงต้องผ่าน Firebase Auth (Admin SDK) — ที่นี่ปิดใช้งานผ่าน active:false แทน
    }

    match /customers/{customerId} {
      allow read, write: if hasRole(['ADMIN', 'STAFF', 'ACCOUNTING']);
    }

    // ผู้ติดต่อของลูกค้า (Contact) — Entity แยกจาก CustomerRecord.contact เดิม อ้างอิงกลับด้วย customerId สิทธิ์เดียวกับ customers
    match /contacts/{contactId} {
      allow read, write: if hasRole(['ADMIN', 'STAFF', 'ACCOUNTING']);
    }

    match /drivers/{driverId} {
      allow read, write: if hasRole(['ADMIN', 'DISPATCHER']);
    }

    match /vehicles/{vehicleId} {
      allow read, write: if hasRole(['ADMIN', 'DISPATCHER']);
    }

    // DRIVER รวมอยู่ด้วยเพราะ Driver App เขียน booking ตรงๆ (รับสินค้า/ส่งของ/จบงาน) ผ่าน uid ของคนขับเอง
    match /bookings/{bookingId} {
      allow read, write: if hasRole(['ADMIN', 'DISPATCHER', 'STAFF', 'ACCOUNTING', 'DRIVER']);
    }

    // สมุดรายชื่อเสมียน (StaffView.vue) — ตรงกับ meta.roles ของ route settings/staff
    match /staff/{staffId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    // สมุดรายชื่อผู้จำหน่าย (VendorsView.vue) — route settings/vendors ยังปิดใช้งานอยู่ (comment out ใน router/app.ts)
    // เตรียม Rules ไว้ล่วงหน้าเผื่อเปิดใช้งานทีหลัง ไม่ให้ลืมแล้วเผลอปล่อย if true
    match /vendors/{vendorId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    // ค่าตั้งค่าระบบแบบเอกสารเดียว (ค่าน้ำมัน/เงื่อนไขวางบิล/เลขรันเอกสาร ฯลฯ) — sync ข้ามเครื่องผ่าน useFirestoreSettings
    // อ่านได้ทุก role ที่ล็อกอินอยู่ (ใช้แสดงผลในหลายหน้า) แต่แก้ไขได้เฉพาะ ADMIN
    match /settings/{settingKey} {
      allow read: if hasRole(['ADMIN', 'STAFF', 'DISPATCHER', 'ACCOUNTING', 'DRIVER']);
      allow write: if hasRole(['ADMIN']);
    }

    // ต้นทาง/จุดรับสินค้า
    match /origins/{originId} {
      allow read: if hasRole(['ADMIN', 'STAFF', 'DISPATCHER', 'ACCOUNTING', 'DRIVER']);
      allow write: if hasRole(['ADMIN']);
    }

    // สินค้า/สต๊อก — DISPATCHER และ DRIVER เขียนได้เพราะ Driver App ตัดสต๊อกอัตโนมัติตอนรับสินค้า (pickupJobItem)
    match /products/{productId} {
      allow read: if hasRole(['ADMIN', 'STAFF', 'DISPATCHER', 'ACCOUNTING', 'DRIVER']);
      allow write: if hasRole(['ADMIN', 'DISPATCHER', 'DRIVER']);
    }

    match /stockMovements/{movementId} {
      allow read: if hasRole(['ADMIN', 'DISPATCHER']);
      allow write: if hasRole(['ADMIN', 'DISPATCHER', 'STAFF', 'DRIVER']);
    }

    // เอกสารขาย (ใบเสนอราคา/ใบสั่งขาย/ใบวางบิล/ใบกำกับภาษี/ใบเสร็จ) — ตรงกับ meta.roles ของ route กลุ่มเอกสารขาย
    match /salesDocuments/{docId} {
      allow read, write: if hasRole(['ADMIN', 'STAFF', 'ACCOUNTING', 'DISPATCHER']);
    }

    match /salesDocumentItems/{itemId} {
      allow read, write: if hasRole(['ADMIN', 'STAFF', 'ACCOUNTING', 'DISPATCHER']);
    }

    // หนังสือรับรองหัก ณ ที่จ่าย — route wht-certificates
    match /whtCertificates/{certId} {
      allow read, write: if hasRole(['ADMIN', 'ACCOUNTING']);
    }

    // รายการหักเงินเดือนคนขับต่อรอบ — หน้าเงินเดือน (payroll/*) ทุก route จำกัดแค่ ADMIN อยู่แล้ว
    match /payrollDeductions/{deductionId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    // เงินเดือนพนักงานเสมียน (payroll/staff) — เช่นเดียวกับ payrollDeductions จำกัดแค่ ADMIN อยู่แล้ว
    match /staffSalaries/{salaryId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    // ค่าใช้จ่ายประจำรถ (ประกัน/GPS/ค่างวด/อื่นๆ) ผูกกับ vehicleId — ข้อมูลการเงินของรถ จำกัดแค่ ADMIN เหมือน payrollDeductions/staffSalaries
    match /vehicleExpenses/{expenseId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    // สถานะจ่ายรายได้คนขับต่อรอบ (ยังไม่จ่าย/จ่ายแล้ว) — แยกจาก Operational Status ของ Booking โดยเจตนา จำกัดแค่ ADMIN เหมือน payrollDeductions
    match /driverPayments/{paymentId} {
      allow read, write: if hasRole(['ADMIN']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
