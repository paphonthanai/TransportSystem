rules_version = '2';

// ============================================================================================
// Firebase Storage — ตารางสิทธิ์ (แยก path ตาม "ผู้อัปโหลด" ให้เห็นชัดว่าใครเขียนที่ไหนได้)
//
//   path                              | คนขับ (DRIVER)              | ADMIN/DISPATCHER/STAFF | ACCOUNTING
//   ----------------------------------|-----------------------------|------------------------|-----------
//   driver-uploads/{bookingId}/*      | สร้าง (create) ได้อย่างเดียว | อ่าน + แก้ + ลบ         | อ่าน
//                                     | เฉพาะงานของตัวเอง           |                        |
//                                     | อ่านเฉพาะงานของตัวเอง       |                        |
//   office-uploads/{bookingId}/*      | อ่านเฉพาะงานของตัวเอง       | อ่าน + สร้าง + แก้ + ลบ | อ่าน
//                                     | เขียนไม่ได้                 |                        |
//   pod/*, loading/* (path เดิม)      | อ่านเฉพาะงานของตัวเอง       | อ่านอย่างเดียว          | อ่าน
//                                     | เขียนไม่ได้                 | (ไฟล์เก่า ไม่มีใครเขียนเพิ่ม) |
//   ที่อื่นทั้งหมด                     | ปิด                         | ปิด                    | ปิด
//
// ทุกการเขียน: ต้องเป็นไฟล์ภาพ และไม่เกิน 3 MB — บัญชีต้อง active และมีบทบาทตามตาราง
// ยืนยันตัวตนคนขับด้วย Firebase Auth uid -> users/{uid}.driverId เทียบกับ bookings/{bookingId}.driverId
// ชื่อไฟล์ที่แอปสร้าง: loading-{เวลา}.jpg / goods-{รหัสรายการ}-{เวลา}.jpg / note-{รหัสรายการ}-{เวลา}.jpg (ห้ามซ้ำ)
// path ต้องตรงกับ src/utils/photoUpload.ts (photoPaths) — แก้ที่หนึ่งต้องแก้อีกที่
// ============================================================================================

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Storage rules เรียก Firestore ข้าม service ได้ผ่าน firestore.get() (ต่างจาก Firestore rules เองที่ใช้ get()
    // เฉยๆ) — ใช้เช็ค role เดียวกับ firestore.rules (userRole()/hasRole()) ไม่สร้างระบบสิทธิ์แยกต่างหาก
    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isActive() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function hasRole(roles) {
      return isSignedIn() && isActive() && userRole() in roles;
    }

    function myDriverId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.driverId;
    }

    // รูปต้องเป็นไฟล์ภาพและไม่เกิน 3 MB (ฝั่งแอปย่อ/บีบเหลือราว 350 KB ก่อนอัปโหลดอยู่แล้ว)
    function isImageUnder3Mb() {
      return request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    function isOffice() {
      return hasRole(['ADMIN', 'DISPATCHER', 'STAFF']);
    }

    // งานนี้เป็นของคนขับที่ล็อกอินอยู่หรือไม่
    function isMyBooking(bookingId) {
      return hasRole(['DRIVER']) && myDriverId() == firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.driverId;
    }

    // อ่านรูปงาน: ออฟฟิศ/บัญชีอ่านได้ทุกงาน ส่วนคนขับอ่านได้เฉพาะงานของตัวเอง
    function canReadBookingPhoto(bookingId) {
      return hasRole(['ADMIN', 'DISPATCHER', 'STAFF', 'ACCOUNTING']) || isMyBooking(bookingId);
    }

    // โซนคนขับ: รูปที่คนขับถ่ายจากแอป — คนขับ "สร้างได้อย่างเดียว" ทับ/ลบไม่ได้ ออฟฟิศแก้/ลบได้
    match /driver-uploads/{bookingId}/{fileName} {
      allow read: if canReadBookingPhoto(bookingId);
      allow create: if (isMyBooking(bookingId) || isOffice()) && isImageUnder3Mb();
      allow update: if isOffice() && isImageUnder3Mb();
      allow delete: if isOffice();
    }

    // โซนออฟฟิศ: รูปที่เสมียน/แอดมินแนบแทนคนขับ — เขียนได้เฉพาะออฟฟิศ คนขับอ่านของงานตัวเองได้อย่างเดียว
    match /office-uploads/{bookingId}/{fileName} {
      allow read: if canReadBookingPhoto(bookingId);
      allow write: if isOffice() && isImageUnder3Mb();
    }

    // path เดิม (ก่อนแยกโซน) — เหลือไว้ให้อ่านไฟล์เก่าเท่านั้น ไม่มีใครเขียนเพิ่มได้
    match /pod/{bookingId}/{jobItemId}/{fileName} {
      allow read: if canReadBookingPhoto(bookingId);
      allow write: if false;
    }
    match /loading/{bookingId}/{fileName} {
      allow read: if canReadBookingPhoto(bookingId);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
