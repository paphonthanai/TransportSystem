rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Storage rules เรียก Firestore ข้าม service ได้ผ่าน firestore.get() (ต่างจาก Firestore rules เองที่ใช้ get()
    // เฉยๆ) — ใช้เช็ค role เดียวกับ firestore.rules (userRole()/hasRole()) ไม่สร้างระบบสิทธิ์แยกต่างหาก
    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isActive() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function hasRole(roles) {
      return isSignedIn() && isActive() && userRole() in roles;
    }

    function myDriverId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.driverId;
    }

    // รูปต้องเป็นไฟล์ภาพและไม่เกิน 3 MB (ฝั่งแอปย่อ/บีบเหลือราว 350 KB ก่อนอัปโหลดอยู่แล้ว)
    function isImageUnder3Mb() {
      return request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // คนขับเขียนได้เฉพาะงานที่ driverId ตรงกับบัญชีตัวเอง (ยืนยันตัวตนผ่าน Firebase Auth uid -> users/{uid}.driverId)
    // ออฟฟิศ (ADMIN/DISPATCHER/STAFF) แนบรูปแทนคนขับได้ ตามที่ธุรกิจให้เสมียนใส่ให้เมื่อคนขับไม่ได้ถ่าย
    function canWriteBookingPhoto(bookingId) {
      return hasRole(['ADMIN', 'DISPATCHER', 'STAFF']) ||
        (hasRole(['DRIVER']) && myDriverId() == firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.driverId);
    }

    // รูปตอนส่งของ (รูปสินค้าตอนลง + รูปใบส่งของ) — path ผูกกับ bookingId/jobItemId กันรูปชนกัน
    match /pod/{bookingId}/{jobItemId}/{fileName} {
      allow read: if hasRole(['ADMIN', 'DISPATCHER', 'STAFF', 'ACCOUNTING', 'DRIVER']);
      allow write: if canWriteBookingPhoto(bookingId) && isImageUnder3Mb();
    }

    // รูปตอนขึ้นสินค้า
    match /loading/{bookingId}/{fileName} {
      allow read: if hasRole(['ADMIN', 'DISPATCHER', 'STAFF', 'ACCOUNTING', 'DRIVER']);
      allow write: if canWriteBookingPhoto(bookingId) && isImageUnder3Mb();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
